# ---- Toobit exchange credentials ----
# Futures trading API key. Needs "futures trade" (write) + read permissions.
TOOBIT_API_KEY=
TOOBIT_API_SECRET=
# API base URL. Production default is https://api.toobit.com
# TOOBIT_API_BASE_URL=https://api.toobit.com
# Print raw response payloads on first use (for verifying field names live).
# TOOBIT_DEBUG_RAW=1

# ---- AI (OpenAI-compatible) ----
AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Numeric user id of the bot owner (only this user may issue commands).
TELEGRAM_USER_ID=

# ---- Persistence ----
# SQLite file. On Railway mount a Volume at /data and use:
DATABASE_PATH=./data/memory.db
# DATABASE_PATH=/data/memory.db
# Legacy XT-style URL is also honoured: DATABASE_URL=sqlite:///data/memory.db

# ---- Web/health ----
PORT=3000
