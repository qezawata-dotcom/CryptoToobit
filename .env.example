# ---- Toobit exchange credentials ----
# Futures trading API key. Needs "futures trade" (write) + read permissions.
TOOBIT_API_KEY=
TOOBIT_API_SECRET=
# API base URL. Production default is https://api.toobit.com
# TOOBIT_API_BASE_URL=https://api.toobit.com
# Print raw response payloads on first use (for verifying field names live).
# TOOBIT_DEBUG_RAW=1

# ---- AI (OpenAI-compatible) ----
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Numeric user id of the bot owner (only this user may issue commands).
TELEGRAM_USER_ID=

# ---- Persistence ----
# SQLite file. On Railway mount a Volume at /data and use:
DATABASE_PATH=./data/memory.db
# DATABASE_PATH=/data/memory.db
# Legacy XT-style URL is also honoured: DATABASE_URL=sqlite:///data/memory.db

# ---- Martingale (runtime-configurable; see README) ----
# The martingale engine reads its settings from the SQLite settings table
# (seeded with the defaults below on first boot), not from env vars. Change
# them at runtime with /settings or by asking the AI assistant. Listed here so
# you know what the defaults are.
#   enabled=false | risk_profile=balanced | mode=ai | leverage=5
#   margin_pct=10 | max_margin_pct=60 | sl_pct=15
# Defaults mirror Config.MARTINGALE_* in src/config.ts.

# ---- Web/health ----
# Railway uses this for the liveness probe (see railway.toml healthcheckPath).
PORT=3000
